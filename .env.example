# ─── Database (Neon Postgres with pgvector) ───────────────────────────────────
# Use the pooled URL for the app; the direct URL for migrations/long jobs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# ─── Neon Managed Better Auth (optional) ──────────────────────────────────────
NEON_AUTH_BASE_URL=""

# ─── Object storage (Neon S3-compatible) ──────────────────────────────────────
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="uploads"

# ─── NTRS harvesting ──────────────────────────────────────────────────────────
IGNIS_TARGET_MB=300

# ─── Embeddings (local, no API key required) ──────────────────────────────────
IGNIS_EMBED_MODEL="BAAI/bge-small-en-v1.5"
IGNIS_EMBED_DIM=384
IGNIS_EMBED_THREADS=4

# ─── Optional LLM (leave unset to use the deterministic extractive synthesizer) ─
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENROUTER_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434"
# IGNIS_LLM_MODEL="gpt-4o-mini"

# ─── Python interpreter used by the API bridge ────────────────────────────────
IGNIS_PYTHON="python3"
