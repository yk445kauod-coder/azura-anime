# ─── Database (Neon Postgres with pgvector) ───────────────────────────────────
# Use the pooled URL for the app; the direct URL for migrations/long jobs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# ─── Neon Managed Better Auth (optional) ──────────────────────────────────────
NEON_AUTH_BASE_URL=""

# ─── Object storage (Neon S3-compatible) ──────────────────────────────────────
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="uploads"

# ─── NTRS harvesting ──────────────────────────────────────────────────────────
IGNIS_TARGET_MB=300

# ─── Embeddings (local, no API key required) ──────────────────────────────────
IGNIS_EMBED_MODEL="BAAI/bge-small-en-v1.5"
IGNIS_EMBED_DIM=384
IGNIS_EMBED_THREADS=4

# ─── LLM providers (optional) ─────────────────────────────────────────────────
# Providers are tried in order until one answers; a failure degrades to the next
# rather than failing the request. With none configured, IGNIS falls back to the
# deterministic extractive synthesizer and still returns a grounded, cited answer.
# Override the order with IGNIS_LLM_PROVIDERS (comma separated).
# IGNIS_LLM_PROVIDERS="cloudflare,neon,gemini,agentrouter,openai,openrouter,ollama"

# Google AI Studio (OpenAI-compatible). Model names rotate; check
# GET /v1beta/models for what the key can currently reach.
# Cloudflare AI Gateway — proxies a third-party provider and egresses from
# Cloudflare's network. Requires AI Gateway permission on the API token.
# CLOUDFLARE_GATEWAY_ID="default"
# CLOUDFLARE_GATEWAY_PROVIDER="openai"          # or google-ai-studio, anthropic
# CLOUDFLARE_GATEWAY_KEY=""                     # the upstream provider's key
# CLOUDFLARE_GATEWAY_MODEL="claude-opus-4-6"

# AgentRouter reached through the Neon Function in functions/ignisllm/.
# Use this when the local network is WAF-blocked; the function egresses from
# Neon instead. IGNIS_PROXY_TOKEN is the shared secret the function checks, and
# is what keeps the upstream key off the client.
# IGNIS_AGENTROUTER_PROXY_URL="https://<branch>-ignisllm.compute.<cell>.us-east-1.aws.neon.tech"
# IGNIS_PROXY_TOKEN=""
# IGNIS_AGENTROUTER_MODEL="claude-opus-4-6"

# Cloudflare Workers AI — free tier, runs open models (Llama, Qwen, GPT-OSS)
# on Cloudflare's edge. Account-scoped, so no third-party WAF is involved.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Neon AI Gateway — one Neon credential for Claude / GPT / Gemini / open-source
# models, hosted by Neon and not behind a client-fingerprinting WAF. Enable
# `aiGateway` on the branch, then `neon env pull` writes these two variables.
# Recommended when a third-party gateway blocks this network.
# NEON_AI_GATEWAY_BASE_URL="https://<branch-id>-api.ai.<region>.aws.neon.tech"
# NEON_AI_GATEWAY_TOKEN="nt_live_..."
# NEON_AI_GATEWAY_MODEL="claude-sonnet-4-6"

# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.1-flash-lite"

# AgentRouter gateway (OpenAI-compatible).
# AGENTROUTER_API_KEY=""
# AgentRouter speaks the Anthropic Messages protocol by default because its WAF
# fingerprints clients at the TLS layer. Set AGENTROUTER_STYLE=openai to use
# chat-completions instead.
# AGENTROUTER_BASE_URL="https://agentrouter.org"   # no /v1 for the Anthropic path
# AGENTROUTER_STYLE="anthropic"
# AGENTROUTER_MODEL="claude-opus-4-6"

# Any other OpenAI-compatible endpoint.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-4o-mini"

# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"

# IGNIS_LLM_MODEL=""   # force one model across every provider

# ─── Python interpreter used by the API bridge ────────────────────────────────
IGNIS_PYTHON="python3"
